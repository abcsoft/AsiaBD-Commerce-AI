# AsiaBD Commerce AI — environment configuration
#
# The app runs in demo mode with realistic sample output when
# ANTHROPIC_API_KEY is not set. No variables are required to boot.

# --- Anthropic Claude (server-side only — never expose to the client) --------
ANTHROPIC_API_KEY=
# Optional: override the Claude model id (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=

# --- Behavior ----------------------------------------------------------------
# Force demo mode even if an API key is present ("1" to enable)
DEMO_MODE=

# Public app URL (used for metadata / links).
# In production with an https:// APP_URL, auth cookies get the `secure` flag;
# leave unset (or non-https) for local http development.
APP_URL=https://asiabd.shop

# --- Storage & credits (optional) --------------------------------------------
# SQLite file location (default: ./data/asiabd.db)
ASIABD_DB_PATH=

# Welcome credits granted to each new workspace (default: 50)
ASIABD_STARTING_CREDITS=
